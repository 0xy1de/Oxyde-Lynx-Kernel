# ------------------------------------------------------------
# Oxyde Lynx Kernel – .gitignore
# Clean kernel source tracking, no build or packaging junk.
# ------------------------------------------------------------

# Kernel build artifacts
*.o
*.ko
*.cmd
*.mod
*.mod.c
*.order
*.symvers
*.dwo
*.lst
*.gcno
*.gcda
*.gcov
*.a
*.s
*.tmp
*.map
*.bin
*.lzo
*.lz4
*.zst
*.xz
*.gz
*.bz2

# Kernel directories generated by make
/debian/
/modules.order
/Module.symvers
/System.map
/vmlinux
/vmlinux.o
/vmlinux.bin
/vmlinux.symvers
/vmlinux-gdb.py
/init/
include/config/
include/generated/
arch/*/include/generated/
arch/*/boot/
arch/*/boot/compressed/vmlinux*
arch/*/boot/bzImage
arch/*/boot/Image
arch/*/boot/Image.gz
drivers/net/wireless/*/modules.order
Documentation/output/

# Cleaning stages
*.old
*.orig
*.rej
*~
*.bak
*.patch~
*.diff~
*.swp
*.swo
*.DS_Store

# Out-of-tree build directories
/out/
/build/
/build-*/
/obj/
/obj-*/
/tmp/
/tmp_*/

# ccache and LLVM intermediate outputs
ccache/
*.o.tmp
*.ll
*.bc

# PKGBUILD / Arch package artifacts
/pkg/
/src/
*.pkg.tar.*
*.tar.xz
*.tar.zst
*.tar.gz
*.log
*.sig
*.deb
*.rpm
*.iso

# Git and editor metadata
*.lock
*.log
*.log.*
*.kate-swp
*.vscode/
.idea/
.vscode/
*.user
*~
.DS_Store
Thumbs.db
*.swp

# Custom configs/backups
*.config.old
*.config.backup
defconfig
.config.old
localversion*
*.diff
*.patch
*#*

# Binary blobs (optional – keep clean tree)
firmware/
*.bin

# Temporary build system outputs
/.tmp_versions/
/.sentinel/
/.scripts/
/tags
/cscope.*
/compile_commands.json

# Distribution & packaging
dist/
distclean/
*.pkg.tar.*
*.zip
*.7z

# Backup and temp directories
*~
*.tmp
*.bak
*.old
*.orig
*.rej

# Kernel packaging results
/linux-*-headers*
/linux-*-image*
/linux-*-oxyde*
/arch/x86/boot/compressed/*.o