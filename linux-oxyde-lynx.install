post_install() {
  echo ">> Generating initramfs for linux-oxyde-lynx..."
  mkinitcpio -p linux-oxyde-lynx || true
  echo ">> Installed sysctl: /usr/lib/sysctl.d/99-oxyde-lynx.conf (applied at boot by systemd-sysctl)"
  echo ">> Kernel image: /boot/vmlinuz-linux-oxyde-lynx"
  echo ">> Remember to update your bootloader to use vmlinuz-linux-oxyde-lynx"
}

post_upgrade() {
  post_install "$1"
}

post_remove() {
  echo ">> Removing initramfs preset cache if present..."
  rm -f "/boot/initramfs-linux-oxyde-lynx.img" "/boot/initramfs-linux-oxyde-lynx-fallback.img" 2>/dev/null || true
}