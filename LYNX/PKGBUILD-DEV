# Maintainer: Nick Chiaravalle <chirv@oxy2k.org>
# Local-dev PKGBUILD for Oxyde Lynx — uses your local repo (no network fetch)
# ***Rename to `PKGBUILD` and backup other one to use!***

pkgbase=linux-oxyde-lynx
pkgname=('linux-oxyde-lynx' 'linux-oxyde-lynx-headers')
pkgver=6.16.7
_xanmodrel=xanmod1
pkgrel=1
pkgdesc="Oxyde Lynx Kernel (XanMod $pkgver-$_xanmodrel base) — fast, fluid, focused + universal modules [LOCAL SRC]"
arch=('x86_64')
url="https://github.com/yourname/oxyde-lynx-kernel"
license=('GPL2')
makedepends=('bc' 'kmod' 'inetutils' 'libelf' 'python' 'pahole' 'cpio' 'perl' 'openssl' 'git' 'patch')
options=('!strip')  # don't strip kernel images

# Only include local helper files here (no remote sources)
source=(
  "linux-oxyde-lynx.install"
  "linux-oxyde-lynx.preset"
  "oxyde-universal.config"
  "99-oxyde-lynx.conf"
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

# Path to your local kernel source (adjust if different)
_local_src="${HOME}/source/oxyde-lynx-kernel"   # should be a full Linux source tree (XanMod base or your fork)

prepare() {
  cd "${srcdir}"

  # Link your local kernel source into $srcdir
  rm -rf linux-xanmod
  ln -s "${_local_src}" linux-xanmod

  cd linux-xanmod

  # Prefer your tree’s version; fall back to provided pkgver if missing
  if [[ -r Makefile ]]; then
    _v=$(grep -E '^(VERSION|PATCHLEVEL|SUBLEVEL|EXTRAVERSION)[[:space:]]*=' Makefile | awk '{print $3}' | tr '\n' '.')
    echo ">> Detected kernel version from Makefile: ${_v}"
  fi

  # Start from either your repo’s .config or a known-good one, then merge our preset
  if [[ -f .config ]]; then
    echo ">> Using existing .config from local repo"
  elif [[ -f /boot/config-$(uname -r) ]]; then
    cp /boot/config-$(uname -r) .config
  fi

  if [[ -x scripts/kconfig/merge_config.sh && -f "${srcdir}/oxyde-universal.config" ]]; then
    scripts/kconfig/merge_config.sh -m .config "${srcdir}/oxyde-universal.config"
  elif [[ -f "${srcdir}/oxyde-universal.config" ]]; then
    cp "${srcdir}/oxyde-universal.config" .config
  fi

  make olddefconfig
}

build() {
  cd "${srcdir}/linux-xanmod"
  make -j"$(nproc)" bzImage modules
}

_package_kernel() {
  pkgdesc+=" (kernel image and modules)"
  depends=('coreutils' 'kmod' 'mkinitcpio>=38')
  conflicts=('linux' 'linux-lts' 'linux-zen' 'linux-xanmod')
  provides=("kernel26=${pkgver}")

  cd "${srcdir}/linux-xanmod"

  # Determine release string for /usr/lib/modules/<release>
  _krel="$(make kernelrelease)"
  echo ">> kernelrelease: ${_krel}"

  # Install modules
  make INSTALL_MOD_PATH="${pkgdir}" modules_install

  # Install kernel image, System.map, config
  install -Dm755 arch/x86/boot/bzImage "${pkgdir}/boot/vmlinuz-${pkgbase}"
  install -Dm644 System.map "${pkgdir}/usr/lib/modules/${_krel}/System.map"
  install -Dm644 .config     "${pkgdir}/usr/lib/modules/${_krel}/config"
  install -Dm644 "${srcdir}/linux-oxyde-lynx.preset" "${pkgdir}/etc/mkinitcpio.d/${pkgbase}.preset"
  sed -i "s|@@PKGBASE@@|${pkgbase}|g" "${pkgdir}/etc/mkinitcpio.d/${pkgbase}.preset"

  # Record pkgbase
  echo "${pkgbase}" > "${pkgdir}/usr/lib/modules/${_krel}/pkgbase"

  # Sysctl (applied by systemd-sysctl at boot)
  install -Dm644 "${srcdir}/99-oxyde-lynx.conf" "${pkgdir}/usr/lib/sysctl.d/99-oxyde-lynx.conf"

  # .INSTALL hook (mkinitcpio run after install)
  install -Dm755 "${srcdir}/linux-oxyde-lynx.install" "${pkgdir}/.INSTALL"
}

_package_headers() {
  pkgdesc+=" (headers)"
  depends=('perl')
  conflicts=('linux-headers' 'linux-xanmod-headers')
  provides=("linux-headers=${pkgver}")

  cd "${srcdir}/linux-xanmod"

  _krel="$(make kernelrelease)"
  _bdir="${pkgdir}/usr/lib/modules/${_krel}/build"

  make -j"$(nproc)" headers
  find usr/include -name '.*' -delete

  install -Dm644 usr/include/* -t "${_bdir}/include/"
  install -Dm644 Makefile        "${_bdir}/Makefile"
  install -Dm644 Module.symvers  "${_bdir}/Module.symvers"
  install -Dm644 System.map      "${_bdir}/System.map"
  install -Dm644 .config         "${_bdir}/.config"
  cp -a scripts "${_bdir}/"
  ln -sr "${_bdir}" "${pkgdir}/usr/lib/modules/${_krel}/source"
}

package_linux-oxyde-lynx()        { _package_kernel; }
package_linux-oxyde-lynx-headers() { _package_headers; }