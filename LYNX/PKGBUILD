# Maintainer: Nick Chiaravalle <chirv@oxy2k.org>
# Local-dev PKGBUILD for Oxyde Lynx — uses the kernel root one level up (no network fetch)

pkgbase=linux-oxyde-lynx
pkgname=('linux-oxyde-lynx' 'linux-oxyde-lynx-headers')
pkgver=6.16.7
_xanmodrel=xanmod1
pkgrel=1
pkgdesc="Oxyde Lynx Kernel (XanMod $pkgver-$_xanmodrel base) — fast, fluid, focused + universal modules [LOCAL SRC]"
arch=('x86_64')
url="https://github.com/0xy1de/Oxyde-Lynx-Kernel/"
license=('GPL2')
makedepends=('bc' 'kmod' 'inetutils' 'libelf' 'python' 'pahole' 'cpio' 'perl' 'openssl' 'git' 'patch')
options=('!strip')

# Helper files only (no remote sources)
source=(
  "linux-oxyde-lynx.install"
  "linux-oxyde-lynx.preset"
  "oxyde-universal.config"
  "99-oxyde-lynx.conf"
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

# Kernel root is the parent of this LYNX/ dir
_local_src="${startdir}/.."

prepare() {
  cd "${srcdir}"
  rm -rf linux-xanmod
  # Link the kernel root (..) into $srcdir as linux-xanmod
  ln -snf "${_local_src}" linux-xanmod

  echo ">> _local_src resolves to: ${_local_src}"
  ls -la linux-xanmod | sed 's/^/>> /'

  cd linux-xanmod

  # Seed .config, then merge our preset
  if [[ ! -f .config ]]; then
    [[ -f /boot/config-$(uname -r) ]] && cp /boot/config-$(uname -r) .config
  fi

  if [[ -x scripts/kconfig/merge_config.sh && -f "${startdir}/oxyde-universal.config" ]]; then
    scripts/kconfig/merge_config.sh -m .config "${startdir}/oxyde-universal.config"
  else
    cp "${startdir}/oxyde-universal.config" .config
  fi

  make olddefconfig

  # Optional: show detected kernelrelease
  _krel="$(make kernelrelease)"
  echo ">> kernelrelease in prepare(): ${_krel}"
}

build() {
  cd "${srcdir}/linux-xanmod"
  make -j"$(nproc)" bzImage modules
}

_package_kernel() {
  pkgdesc+=" (kernel image and modules)"
  depends=('coreutils' 'kmod' 'mkinitcpio>=38')
  conflicts=('linux' 'linux-lts' 'linux-zen' 'linux-xanmod')
  provides=("kernel26=${pkgver}")

  cd "${srcdir}/linux-xanmod"

  _krel="$(make kernelrelease)"
  echo ">> kernelrelease: ${_krel}"

  make INSTALL_MOD_PATH="${pkgdir}" modules_install

  install -Dm755 arch/x86/boot/bzImage "${pkgdir}/boot/vmlinuz-${pkgbase}"
  install -Dm644 System.map "${pkgdir}/usr/lib/modules/${_krel}/System.map"
  install -Dm644 .config     "${pkgdir}/usr/lib/modules/${_krel}/config"

  install -Dm644 "${startdir}/linux-oxyde-lynx.preset" \
    "${pkgdir}/etc/mkinitcpio.d/${pkgbase}.preset"
  sed -i "s|@@PKGBASE@@|${pkgbase}|g" \
    "${pkgdir}/etc/mkinitcpio.d/${pkgbase}.preset"

  echo "${pkgbase}" > "${pkgdir}/usr/lib/modules/${_krel}/pkgbase"

  install -Dm644 "${startdir}/99-oxyde-lynx.conf" \
    "${pkgdir}/usr/lib/sysctl.d/99-oxyde-lynx.conf"

package_linux-oxyde-lynx() {
  install=${pkgbase}.install
  backup=('usr/lib/sysctl.d/99-oxyde-lynx.conf')
  _package_kernel
}
package_linux-oxyde-lynx-headers() { _package_headers; }}

_package_headers() {
  pkgdesc+=" (headers)"
  depends=('perl')
  conflicts=('linux-headers' 'linux-xanmod-headers')
  provides=("linux-headers=${pkgver}")

  cd "${srcdir}/linux-xanmod"

  # Compute the exact release string (matches uname -r)
  _krel="$(make kernelrelease)"
  _moddir="${pkgdir}/usr/lib/modules/${_krel}"
  _bdir="${_moddir}/build"

  # Ensure the kernel tree is prepared for external modules
  # (Module.symvers exists after our build() which built 'modules')
  make prepare
  make modules_prepare

  # Create target dirs
  install -d "${_bdir}"

  # Core metadata needed by DKMS/out-of-tree modules
  install -Dm644 .config        "${_bdir}/.config"
  [[ -f Module.symvers ]] && install -Dm644 Module.symvers "${_bdir}/Module.symvers" || true
  [[ -f System.map   ]] && install -Dm644 System.map       "${_bdir}/System.map"     || true
  install -Dm644 Makefile       "${_bdir}/Makefile"

  # Copy scripts and headers expected by Kbuild
  cp -a scripts "${_bdir}/"

  # Top-level include/ (generated headers were created by make prepare)
  mkdir -p "${_bdir}/include"
  cp -a include/* "${_bdir}/include/"

  # Architecture-specific bits (x86_64)
  mkdir -p "${_bdir}/arch/x86"
  cp -a arch/x86/Makefile "${_bdir}/arch/x86/Makefile"
  cp -a arch/x86/include  "${_bdir}/arch/x86/"

  # A few generated include/ artifacts can be missing if the build stopped early.
  # Ensure they exist (best-effort) by re-running prepare if needed.
  [[ -d include/generated ]] || make prepare

  # Provide the canonical 'source' symlink expected by many build systems
  ln -sr "${_bdir}" "${_moddir}/source"
}

package_linux-oxyde-lynx()         { _package_kernel; }
package_linux-oxyde-lynx-headers() { _package_headers; }