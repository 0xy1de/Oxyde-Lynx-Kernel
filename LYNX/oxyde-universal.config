#
# Oxyde Lynx Kernel — Universal Preset (XanMod 6.16.x base)
# Safe-for-everyone defaults: broad HW support as modules, low latency, low bloat.
#

CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_MICROCODE=y
CONFIG_X86_MCE=y
CONFIG_NUMA=y
CONFIG_ACPI=y
CONFIG_PM=y
CONFIG_PM_SLEEP=y

CONFIG_PREEMPT_DYNAMIC=y
CONFIG_HZ_1000=y
CONFIG_NO_HZ_IDLE=y
CONFIG_SCHED_AUTOGROUP=y

CONFIG_KERNEL_ZSTD=y
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO=n
CONFIG_KASAN=n
CONFIG_KCSAN=n
CONFIG_KFENCE=n
CONFIG_UBSAN=n
CONFIG_FTRACE=n
CONFIG_LOCKDEP=n

CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=m
CONFIG_BTRFS_FS=m
CONFIG_XFS_FS=m
CONFIG_F2FS_FS=m
CONFIG_ISO9660_FS=m
CONFIG_UDF_FS=m
CONFIG_NFS_FS=m

CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_I915=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_NOUVEAU=m

CONFIG_SND_HDA_INTEL=m
CONFIG_SND_USB_AUDIO=m

CONFIG_NET=y
CONFIG_IPV6=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_CAKE=m
CONFIG_VLAN_8021Q=m
CONFIG_BRIDGE=m
CONFIG_WIREGUARD=m

CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_IWLWIFI=m
CONFIG_RTW88=m
CONFIG_RTW89=m

CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m

CONFIG_ISA=n
CONFIG_PCMCIA=n
CONFIG_PARPORT=n
CONFIG_STAGING=n

CONFIG_IPX=n
CONFIG_ATALK=n
CONFIG_DECNET=n
CONFIG_X25=n

CONFIG_IA32_EMULATION=m

CONFIG_SECURITY_APPARMOR=m
CONFIG_SECURITY_SELINUX=m
