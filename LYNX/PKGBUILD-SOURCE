# Maintainer: Nick Chiaravalle <chirv@oxy2k.org>
# Backup PKGBUILD and rename this accordingly. Builds from source, not from workspace.
pkgbase=linux-oxyde-lynx
pkgname=('linux-oxyde-lynx' 'linux-oxyde-lynx-headers')
pkgver=6.16.7
_xanmodrel=xanmod1
pkgrel=1
pkgdesc="Oxyde Lynx Kernel (XanMod $pkgver-$_xanmodrel base) — fast, fluid, focused + universal hardware modules"
arch=('x86_64')
url="https://github.com/0xy1de/Oxyde-Lynx-Kernel"
license=('GPL2')
makedepends=('bc' 'kmod' 'inetutils' 'libelf' 'python' 'pahole' 'cpio' 'perl' 'openssl' 'git')
options=('!strip')  # kernel images shouldn't be stripped
source=(
  "linux-xanmod::git+https://gitlab.com/xanmod/linux.git#tag=${pkgver}-${_xanmodrel}"
  "linux-oxyde-lynx.install"
  "linux-oxyde-lynx.preset"
  "oxyde-universal.config"
  "99-oxyde-lynx.conf"
)
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

prepare() {
  cd "${srcdir}/linux-xanmod"
  # Start from XanMod's baseline config if present for this tag; otherwise from /boot
  if [[ -f CONFIGS/x86_64/xanmod.config ]]; then
    cp CONFIGS/x86_64/xanmod.config .config
  elif [[ -f /boot/config-$(uname -r) ]]; then
    cp /boot/config-$(uname -r) .config
  fi

  # Merge our universal preset
  if [[ -f .config ]]; then
    # Use kernel's merge_config script if available
    if [[ -x scripts/kconfig/merge_config.sh ]]; then
      scripts/kconfig/merge_config.sh -m .config "${srcdir}/oxyde-universal.config"
    else
      cp "${srcdir}/oxyde-universal.config" .config
    fi
  else
    cp "${srcdir}/oxyde-universal.config" .config
  fi

  make olddefconfig
}

build() {
  cd "${srcdir}/linux-xanmod"
  make -j"$(nproc)" bzImage modules
}

_package_kernel() {
  pkgdesc+=" (kernel image and modules)"
  depends=('coreutils' 'kmod' 'mkinitcpio>=38')
  provides=("kernel26=${pkgver}")
  conflicts=('linux' 'linux-lts' 'linux-zen' 'linux-xanmod')
  replaces=()

  cd "${srcdir}/linux-xanmod"

  # Install modules to pkgdir
  make INSTALL_MOD_PATH="${pkgdir}" modules_install

  # Install kernel image, System.map, config
  install -Dm644 System.map "${pkgdir}/usr/lib/modules/${pkgver}-${_xanmodrel}-oxyde/System.map"
  install -Dm644 .config "${pkgdir}/usr/lib/modules/${pkgver}-${_xanmodrel}-oxyde/config"
  install -Dm755 arch/x86/boot/bzImage "${pkgdir}/boot/vmlinuz-${pkgbase}"

  # KERNEL RELEASE file (uname -r)
  _krel="${pkgver}-${_xanmodrel}-oxyde"
  echo "${_krel}" > "${pkgdir}/usr/lib/modules/${_krel}/pkgbase"

  # Set module dep list
  depmod -b "${pkgdir}" "${_krel}" || true

  # Install mkinitcpio preset
  install -Dm644 "${srcdir}/linux-oxyde-lynx.preset" "${pkgdir}/etc/mkinitcpio.d/${pkgbase}.preset"
  sed -i "s|@@PKGBASE@@|${pkgbase}|g" "${pkgdir}/etc/mkinitcpio.d/${pkgbase}.preset"

  # Install sysctl file
  install -Dm644 "${srcdir}/99-oxyde-lynx.conf" "${pkgdir}/usr/lib/sysctl.d/99-oxyde-lynx.conf"

  # Hook: post-install tasks (mkinitcpio, bootloader hints)
  install -Dm755 "${srcdir}/linux-oxyde-lynx.install" "${pkgdir}/.INSTALL"
}

_package_headers() {
  pkgdesc+=" (headers)"
  depends=('perl')
  conflicts=('linux-headers' 'linux-xanmod-headers')
  provides=("linux-headers=${pkgver}")
  replaces=()

  cd "${srcdir}/linux-xanmod"

  install -Dm644 .config "${pkgdir}/usr/lib/modules/${pkgver}-${_xanmodrel}-oxyde/build/.config"

  # Headers (same as Arch linux PKGBUILDs)
  make -j"$(nproc)" headers
  find usr/include -name '.*' -delete
  install -Dm644 usr/include/* -t "${pkgdir}/usr/lib/modules/${pkgver}-${_xanmodrel}-oxyde/build/include/"

  install -Dm644 Makefile      "${pkgdir}/usr/lib/modules/${pkgver}-${_xanmodrel}-oxyde/build/Makefile"
  install -Dm644 Module.symvers "${pkgdir}/usr/lib/modules/${pkgver}-${_xanmodrel}-oxyde/build/Module.symvers"
  install -Dm644 System.map    "${pkgdir}/usr/lib/modules/${pkgver}-${_xanmodrel}-oxyde/build/System.map"
  install -Dm644 .config       "${pkgdir}/usr/lib/modules/${pkgver}-${_xanmodrel}-oxyde/build/.config"

  mkdir -p "${pkgdir}/usr/lib/modules/${pkgver}-${_xanmodrel}-oxyde/build"
  cp -a scripts "${pkgdir}/usr/lib/modules/${pkgver}-${_xanmodrel}-oxyde/build/"

  # Fix build symlink
  ln -sr "${pkgdir}/usr/lib/modules/${pkgver}-${_xanmodrel}-oxyde/build" \
         "${pkgdir}/usr/lib/modules/${pkgver}-${_xanmodrel}-oxyde/source"
}

package_linux-oxyde-lynx() { _package_kernel; }
package_linux-oxyde-lynx-headers() { _package_headers; }